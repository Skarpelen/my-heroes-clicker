<Window x:Class="MyHeroesClicker.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="My Heroes Clicker"
        Width="1180"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_OnClosing">
  <Grid Background="#f4f6f8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="16"
            Background="#ffffff"
            BorderBrush="#d7dde5"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="My Heroes Clicker"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#17202a" />
            <TextBlock x:Name="VersionTextBlock"
                       Margin="10,5,0,0"
                       FontSize="12"
                       Foreground="#617080" />
          </StackPanel>
          <TextBlock x:Name="StatusTextBlock"
                     Visibility="Collapsed" />
          <TextBlock x:Name="UpdateStatusTextBlock"
                     Margin="0,4,0,0"
                     FontSize="13"
                     Foreground="#3d5872"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="ErrorTextBlock"
                     Margin="0,4,0,0"
                     FontSize="13"
                     Foreground="#b3261e"
                     TextWrapping="Wrap" />
          <Expander x:Name="ChangelogExpander"
                    Margin="0,6,0,0"
                    Header="Что нового"
                    IsExpanded="False"
                    Visibility="Collapsed">
            <TextBox x:Name="ChangelogTextBox"
                     MaxHeight="160"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="#243242"
                     Background="#f7f9fb"
                     BorderBrush="#d7dde5"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
          </Expander>
          <Expander x:Name="DiagnosticsExpander"
                    Margin="0,6,0,0"
                    Header="Диагностика"
                    IsExpanded="False">
            <TextBox x:Name="DiagnosticsTextBox"
                     MaxHeight="130"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="#243242"
                     Background="#f7f9fb"
                     BorderBrush="#d7dde5"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
          </Expander>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">
          <Button x:Name="StartButton"
                  Width="110"
                  Margin="0,0,8,0"
                  Padding="10,6"
                  Click="StartButton_OnClick"
                  Content="Запустить" />
          <Button x:Name="OpenBrowserButton"
                  Width="150"
                  Margin="0,0,8,0"
                  Padding="10,6"
                  Click="OpenBrowserButton_OnClick"
                  Content="Открыть в браузере"
                  IsEnabled="False" />
          <Button x:Name="CheckUpdatesButton"
                  Width="155"
                  Margin="0,0,8,0"
                  Padding="10,6"
                  Click="CheckUpdatesButton_OnClick"
                  Content="Проверить обновления" />
          <Button x:Name="InstallUpdateButton"
                  Width="145"
                  Padding="10,6"
                  Click="InstallUpdateButton_OnClick"
                  Content="Обновить"
                  IsEnabled="False"
                  Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Margin="16"
            Background="#ffffff"
            BorderBrush="#d7dde5"
            BorderThickness="1">
      <wv2:WebView2 x:Name="Browser"
                    NavigationStarting="Browser_OnNavigationStarting" />
    </Border>
  </Grid>
</Window>
