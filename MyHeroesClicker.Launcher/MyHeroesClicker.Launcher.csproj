<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyHeroesClicker.Launcher</AssemblyName>
    <RootNamespace>MyHeroesClicker.Launcher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyHeroesClicker.API\MyHeroesClicker.API.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\MyHeroesClicker.DbMigrator\MyHeroesClicker.DbMigrator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
