<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.59.0" GeneratePathProperty="true" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyHeroesClicker.Browser\MyHeroesClicker.Browser.csproj" />
    <ProjectReference Include="..\MyHeroesClicker.Core\MyHeroesClicker.Core.csproj" />
    <ProjectReference Include="..\MyHeroesClicker.DataSQLite\MyHeroesClicker.DataSQLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\MyHeroesClicker.Web\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPlaywrightWindowsNodeToPublishDirectory"
          AfterTargets="CopyFilesToPublishDirectory"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(PkgMicrosoft_Playwright)' != ''">
    <ItemGroup>
      <PlaywrightWindowsNodeFiles Include="$(PkgMicrosoft_Playwright)\.playwright\node\win32_x64\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PlaywrightWindowsNodeFiles)"
          DestinationFiles="@(PlaywrightWindowsNodeFiles->'$(PublishDir).playwright\node\win32_x64\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
